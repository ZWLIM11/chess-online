{
  "name": "arcane-chess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:cloudflare": "pnpm build && node scripts/prepare-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/build-ai.mjs && node scripts/run-framework.mjs dev",
    "build": "node scripts/build-ai.mjs && node scripts/run-framework.mjs build && node scripts/offline-manifest.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/chess-engine.test.ts tests/cloudflare-deploy.test.mjs && node scripts/test-battle.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "19.2.6",
    "zod": "3.25.76",
    "three": "0.180.0",
    "drizzle-orm": "0.45.2",
    "react-dom": "19.2.6",
    "next": "16.3.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
